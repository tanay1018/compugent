# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
# Used ONLY by the discovery path. Replay never calls a model.
AI_GATEWAY_API_KEY=vck_your_key_here

# Model for the DISCOVERY loop — any gateway-routable model with tool-use.
# This is the multi-step, expensive path. `npm run models` lists the options
# with live prices.
DISCOVERY_MODEL=anthropic/claude-opus-5

# Roughly 10x cheaper for the loop, still strong at tool-calling:
# DISCOVERY_MODEL=anthropic/claude-sonnet-5
# DISCOVERY_MODEL=openai/gpt-5-mini
# DISCOVERY_MODEL=deepseek/deepseek-v4-flash

# Model for COMPILATION. One call, but its judgement shapes the capability
# contract for every future invocation — worth keeping capable even when
# discovery runs on something cheap. Defaults to DISCOVERY_MODEL.
# COMPILE_MODEL=anthropic/claude-opus-5

# How hard the model should think per step. Choosing which of a dozen labelled
# controls to click does not reward extended thinking, and every reasoning token
# is billed on output AND resent as history on the next step.
REASONING_EFFORT=low

# Ceiling on nodes described per screen. A content-heavy page can expose
# hundreds (books.toscrape.com renders 402, Wikipedia 1393) and that is resent
# every step. Controls are never dropped; long runs of text are.
MAX_OBSERVATION_NODES=140

# Port for the bundled MemberDesk 7.2 target app.
TARGET_APP_PORT=8710
