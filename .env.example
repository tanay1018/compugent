# Vercel AI Gateway: https://vercel.com/docs/ai-gateway
# Used by discovery and compilation only. Replay never calls a model.
AI_GATEWAY_API_KEY=vck_your_key_here

# Model for the discovery loop, which makes most of the model calls.
# `npm run models` lists gateway models with tool use, cheapest first.
# The task (read a normalised tree, pick a node, call a tool) does not need the
# most capable model.
DISCOVERY_MODEL=anthropic/claude-sonnet-5

# Cheaper options (~$0.003/run vs ~$0.130 for opus-5). The loop needs reliable
# tool calling, so check a run before relying on these:
# DISCOVERY_MODEL=deepseek/deepseek-v4-flash
# DISCOVERY_MODEL=openai/gpt-5-mini
# DISCOVERY_MODEL=google/gemini-2.5-flash-lite

# Model for compilation. A single call, but it decides the capability's
# parameters and contract, so a stronger model is worth it here.
# Defaults to DISCOVERY_MODEL.
# COMPILE_MODEL=anthropic/claude-opus-5

# Reasoning effort per discovery step. Reasoning tokens are billed as output
# and resent as history on the next step, and picking a control rarely needs them.
REASONING_EFFORT=low

# Maximum nodes rendered per screen. Large pages expose hundreds (Wikipedia
# ~1400), and the screen is resent every step. Controls are kept; long runs of
# text are dropped first.
MAX_OBSERVATION_NODES=140

# Port for the bundled MemberDesk 7.2 target app.
TARGET_APP_PORT=8710
